---
import { FORM_URLS } from '../config/forms';
import FormAttribution from './FormAttribution.astro';

interface Props {
  actionUrl?: string;
  formId?: string;
}

const {
  actionUrl = FORM_URLS.enquiry,
  formId = "project-quote-form",
} = Astro.props;
---

<div class="quote-form-container" id="quote">
  <div class="quote-header">
    <div class="eyebrow">
      <span>Project Estimation Protocol</span>
    </div>
    <h2 class="quote-title">Tell us about your landscaping project.</h2>
    <p class="quote-subtitle">
      Share a few details about your outdoor space. Our principal designers will review your site specifications and prepare a comprehensive proposal.
    </p>
  </div>

  <form
    id={formId}
    action={actionUrl}
    method="POST"
    class="form-card bespoke-quote-form"
    novalidate
  >
    <!-- Rule 6: Honeypot spam defense -->
    <input
      type="text"
      name="_gotcha"
      style="display:none;"
      tabindex="-1"
      autocomplete="off"
    />

    <!-- Dynamic Status Message Container -->
    <div class="form-status-message" role="alert" aria-live="polite"></div>

    <!-- Section 1: Client & Site Coordinates -->
    <fieldset class="form-fieldset">
      <legend class="fieldset-legend">01 &middot; Contact &amp; Property Information</legend>
      <div class="form-grid form-grid-2">
        <!-- Full Name -->
        <div class="form-group">
          <label for={`${formId}-name`} class="form-label">
            <span>Full Name <span class="req" aria-hidden="true">*</span></span>
          </label>
          <input
            type="text"
            id={`${formId}-name`}
            name="name"
            class="form-input"
            placeholder="e.g. Eleanor Vance"
            required
            autocomplete="name"
          />
        </div>

        <!-- Email Address -->
        <div class="form-group">
          <label for={`${formId}-email`} class="form-label">
            <span>Email Address <span class="req" aria-hidden="true">*</span></span>
          </label>
          <input
            type="email"
            id={`${formId}-email`}
            name="email"
            class="form-input"
            placeholder="e.g. eleanor@vancestudio.com"
            required
            autocomplete="email"
          />
        </div>

        <!-- Phone Number -->
        <div class="form-group">
          <label for={`${formId}-phone`} class="form-label">
            <span>Phone Number <span class="req" aria-hidden="true">*</span></span>
          </label>
          <input
            type="tel"
            id={`${formId}-phone`}
            name="phone"
            class="form-input"
            placeholder="e.g. (503) 890-1234"
            required
            autocomplete="tel"
          />
        </div>

        <!-- Project Location / Postcode -->
        <div class="form-group">
          <label for={`${formId}-loc`} class="form-label">
            <span>Location / Postcode <span class="req" aria-hidden="true">*</span></span>
          </label>
          <input
            type="text"
            id={`${formId}-loc`}
            name="project_location"
            class="form-input"
            placeholder="e.g. Lake Oswego, OR 97034"
            required
          />
        </div>

        <!-- Property Type -->
        <div class="form-group col-span-full">
          <label for={`${formId}-prop-type`} class="form-label">
            <span>Property Type <span class="req" aria-hidden="true">*</span></span>
          </label>
          <select
            id={`${formId}-prop-type`}
            name="property_type"
            class="form-select"
            required
          >
            <option value="" disabled selected>Select property classification...</option>
            <option value="Residential">Residential Estate / Single Family</option>
            <option value="Commercial">Commercial Grounds / Corporate Facility</option>
            <option value="Other">Other / Multi-Family Development</option>
          </select>
        </div>
      </div>
    </fieldset>

    <!-- Section 2: Scope & Execution Parameters -->
    <fieldset class="form-fieldset">
      <legend class="fieldset-legend">02 &middot; Project Scope &amp; Schedule</legend>
      <div class="form-grid form-grid-3">
        <!-- Service Required -->
        <div class="form-group">
          <label for={`${formId}-service`} class="form-label">
            <span>Service Required <span class="req" aria-hidden="true">*</span></span>
          </label>
          <select
            id={`${formId}-service`}
            name="service_type"
            class="form-select"
            required
          >
            <option value="" disabled selected>Select practice...</option>
            <option value="Landscape Design">Landscape Design &amp; Master Planning</option>
            <option value="Garden Renovation">Garden Design &amp; Renovation</option>
            <option value="Lawn Installation">Lawn Installation &amp; Turf Care</option>
            <option value="Outdoor Living / Patio">Outdoor Living / Patio &amp; Hardscaping</option>
            <option value="Plant & Tree Installation">Plant &amp; Specimen Tree Installation</option>
            <option value="Commercial Landscaping">Commercial Landscaping &amp; Grounds</option>
            <option value="Irrigation & Drainage">Irrigation &amp; Drainage Engineering</option>
            <option value="Garden Maintenance">Garden Maintenance &amp; Seasonal Care</option>
            <option value="Other">Other Custom Commission</option>
          </select>
        </div>

        <!-- Estimated Budget -->
        <div class="form-group">
          <label for={`${formId}-budget`} class="form-label">
            <span>Budget Allocation</span>
            <span class="optional">Optional</span>
          </label>
          <select
            id={`${formId}-budget`}
            name="budget"
            class="form-select"
          >
            <option value="" selected>Approx investment...</option>
            <option value="Under $1,000">Under $1,000</option>
            <option value="$1,000–$5,000">$1,000–$5,000</option>
            <option value="$5,000–$10,000">$5,000–$10,000</option>
            <option value="$10,000–$25,000">$10,000–$25,000</option>
            <option value="$25,000+">$25,000+ (Master)</option>
            <option value="Not sure yet">Not sure yet</option>
          </select>
        </div>

        <!-- Timeline -->
        <div class="form-group">
          <label for={`${formId}-timeline`} class="form-label">
            <span>Preferred Timeline</span>
            <span class="optional">Optional</span>
          </label>
          <select
            id={`${formId}-timeline`}
            name="timeline"
            class="form-select"
          >
            <option value="" selected>Commencement...</option>
            <option value="Immediately">Immediately (Ready)</option>
            <option value="Within 1 month">Within 1 month</option>
            <option value="Within 3 months">Within 3 months</option>
            <option value="Within 6 months">Within 6 months</option>
            <option value="Just exploring">Just exploring</option>
          </select>
        </div>
      </div>
    </fieldset>

    <!-- Section 3: Vision & Site Conditions -->
    <fieldset class="form-fieldset">
      <legend class="fieldset-legend">03 &middot; Project Vision &amp; Site Notes</legend>
      <div class="form-group">
        <label for={`${formId}-desc`} class="form-label">
          <span>Project Description &amp; Desired Features <span class="req" aria-hidden="true">*</span></span>
        </label>
        <textarea
          id={`${formId}-desc`}
          name="message"
          class="form-textarea"
          rows="3"
          placeholder="Briefly describe your outdoor space, existing site conditions (slope, trees, drainage), and key features desired (patio, planting, lawn, lighting)."
          required
        ></textarea>
      </div>
    </fieldset>

    <!-- Action & Submission Row -->
    <div class="form-submit-stage">
      <button type="submit" class="btn btn-primary btn-md" style="width: 100%; max-width: 380px;">
        <span>Request My Free Estimate</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
      <p class="form-disclaimer">
        Your data is transmitted securely to our estimating desk. We will review your site information and contact you within one business day.
      </p>
    </div>

    <!-- Attribution immediately below form -->
    <FormAttribution />
  </form>
</div>

<style>
  .quote-form-container {
    scroll-margin-top: 6.5rem;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
  }

  .quote-header {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .quote-title {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    margin-bottom: 0.65rem;
    line-height: 1.2;
  }

  .quote-subtitle {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    max-width: 580px;
    margin: 0 auto;
  }

  .bespoke-quote-form {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    padding: clamp(1.25rem, 2.5vw, 1.85rem);
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .form-fieldset {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .form-fieldset:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
  }

  .fieldset-legend {
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-green);
    margin-bottom: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .form-grid-3 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .form-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bespoke-quote-form .form-group {
    gap: 0.35rem;
  }

  .bespoke-quote-form .form-label {
    font-size: 0.8rem;
  }

  .bespoke-quote-form .form-input,
  .bespoke-quote-form .form-select,
  .bespoke-quote-form .form-textarea {
    padding: 0.6rem 0.85rem;
    font-size: 0.875rem;
  }

  .bespoke-quote-form .form-textarea {
    min-height: 80px;
  }

  .form-submit-stage {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    align-items: center;
    padding-top: 0.25rem;
  }

  .form-disclaimer {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.45;
  }
</style>

<script>
  import { attachAjaxFormHandler } from '../scripts/form-handler';

  document.addEventListener('DOMContentLoaded', () => {
    const quoteForm = document.getElementById('project-quote-form') as HTMLFormElement | null;
    if (quoteForm) {
      attachAjaxFormHandler(quoteForm);
    }
  });
</script>
