---
import { BOOKING_CONFIG } from '../config/forms';

interface Props {
  uuid?: string;
  submitUrl?: string;
  slotsUrl?: string;
  apiBase?: string;
  meetingTitle?: string;
  meetingDescription?: string;
  meetingDuration?: number;
}

const {
  uuid = BOOKING_CONFIG.uuid,
  submitUrl = BOOKING_CONFIG.submitUrl,
  slotsUrl = BOOKING_CONFIG.slotsUrl,
  apiBase = BOOKING_CONFIG.apiBase,
  meetingTitle = BOOKING_CONFIG.meetingTitle,
  meetingDescription = BOOKING_CONFIG.meetingDescription,
  meetingDuration = BOOKING_CONFIG.meetingDuration,
} = Astro.props;
---

<div class="booking-section-wrapper" id="booking">
  <div class="booking-header">
    <div class="eyebrow">
      <span>Interactive Consultation Scheduling</span>
    </div>
    <h2 class="booking-title">Let's walk through your project.</h2>
    <p class="booking-subtitle">
      Schedule a dedicated 30-minute site consultation to walk your grounds and explore design possibilities with our principal team.
    </p>
  </div>

  <div class="booking-stage-card">
    <!-- Consultation Scope Strip -->
    <div class="consultation-scope-bar">
      <div class="scope-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Site Topography &amp; Sun</span>
      </div>
      <div class="scope-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Soil &amp; Tree Review</span>
      </div>
      <div class="scope-item">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Material &amp; Budget Scoping</span>
      </div>
    </div>

    <!-- Custom local widget stylesheet -->
    <link rel="stylesheet" href="/booking-widget.css" />

    <!-- Mandatory MFC Booking Widget Mount Container (Strictly configured per specification) -->
    <div
      id="mfc-booking-widget"
      data-booking-widget=""
      data-form-uuid={uuid}
      data-api-base={apiBase}
      data-submit-url={submitUrl}
      data-slots-url={slotsUrl}
      data-meeting-title={meetingTitle}
      data-meeting-description={meetingDescription}
      data-meeting-duration={meetingDuration}
      data-branding-name={BOOKING_CONFIG.brandingName}
      data-branding-url={BOOKING_CONFIG.brandingUrl}
    >
      <!-- Initial Loading Placeholder replaced by booking-widget.js -->
      <div class="mfc-widget-placeholder">
        <div class="mfc-placeholder-spinner" aria-hidden="true"></div>
        <p class="mfc-placeholder-text">Connecting to consultation calendar…</p>
      </div>

      <!-- Noscript Fallback Form (Permits direct submission if JavaScript is disabled) -->
      <noscript>
        <div class="mfc-noscript-box">
          <h3 class="mfc-noscript-title">Schedule a Landscaping Consultation</h3>
          <p class="mfc-noscript-desc">
            Complete the form below to request your 30-minute landscape walkthrough:
          </p>
          <form
            action={submitUrl}
            method="POST"
            class="mfc-noscript-form"
          >
            <!-- Rule 6: Honeypot spam input -->
            <input type="text" name="_gotcha" style="display:none;" tabindex="-1" autocomplete="off" />

            <div class="form-group" style="margin-bottom: 0.75rem;">
              <label class="form-label" for="ns-booking-name" style="font-size: 0.8rem;">Full Name *</label>
              <input type="text" id="ns-booking-name" name="name" class="form-input" style="padding: 0.5rem 0.7rem; font-size: 0.85rem;" required />
            </div>

            <div class="form-group" style="margin-bottom: 0.75rem;">
              <label class="form-label" for="ns-booking-email" style="font-size: 0.8rem;">Email Address *</label>
              <input type="email" id="ns-booking-email" name="email" class="form-input" style="padding: 0.5rem 0.7rem; font-size: 0.85rem;" required />
            </div>

            <div class="form-group" style="margin-bottom: 0.75rem;">
              <label class="form-label" for="ns-booking-phone" style="font-size: 0.8rem;">Phone Number *</label>
              <input type="tel" id="ns-booking-phone" name="phone" class="form-input" style="padding: 0.5rem 0.7rem; font-size: 0.85rem;" required />
            </div>

            <div class="form-group" style="margin-bottom: 0.75rem;">
              <label class="form-label" for="ns-booking-notes" style="font-size: 0.8rem;">Project Overview</label>
              <textarea id="ns-booking-notes" name="message" class="form-textarea" rows="2" style="padding: 0.5rem 0.7rem; font-size: 0.85rem;" placeholder="Briefly describe what you would like to explore..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-md" style="width: 100%; margin-top: 0.5rem;">
              Submit Consultation Request
            </button>
          </form>
        </div>
      </noscript>
    </div>

    <!-- Booking widget client runtime script -->
    <script src="/booking-widget.js" defer></script>

    <!-- Re-dispatch DOM events to guarantee widget mount on route transitions -->
    <script is:inline>
      (function () {
        function initBookingWidget() {
          document.dispatchEvent(new Event('DOMContentLoaded'));
          document.dispatchEvent(new Event('turbo:render'));
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initBookingWidget);
        } else {
          initBookingWidget();
        }
      })();
    </script>
  </div>
</div>

<style>
  .booking-section-wrapper {
    scroll-margin-top: 6.5rem;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }

  .booking-header {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .booking-title {
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    margin-bottom: 0.35rem;
    line-height: 1.2;
    text-align: center;
  }

  .booking-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }

  .booking-stage-card {
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(1.15rem, 2.2vw, 1.45rem);
    box-shadow: var(--shadow-sm);
    width: 100%;
  }

  .consultation-scope-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.75rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .scope-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-dark-green);
  }

  .scope-item svg {
    color: var(--color-primary-green);
    flex-shrink: 0;
  }

  .mfc-widget-placeholder {
    padding: 2rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text-secondary);
  }

  .mfc-placeholder-spinner {
    width: 1.75rem;
    height: 1.75rem;
    border: 2.5px solid rgba(27, 48, 38, 0.15);
    border-top-color: var(--color-primary-green);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .mfc-placeholder-text {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .mfc-noscript-box {
    padding: 1.25rem;
    background: var(--bg-primary);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .mfc-noscript-title {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
    color: var(--color-dark-green);
  }

  .mfc-noscript-desc {
    font-size: 0.8rem;
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
  }
</style>
