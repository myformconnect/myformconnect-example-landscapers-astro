---
import { COMPANY_INFO } from '../config/forms';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`mfc-attribution ${className}`}>
  Powered by{' '}
  <a
    href={COMPANY_INFO.attribution.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="MyFormConnect official website (opens in new tab)"
  >
    <span>MyFormConnect</span>
  </a>
</div>
