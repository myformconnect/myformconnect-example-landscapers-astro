---
import { BOOKING_CONFIG } from '../config/forms';
import FormAttribution from './FormAttribution.astro';

interface Props {
  uuid?: string;
  submitUrl?: string;
  slotsUrl?: string;
  apiBase?: string;
  meetingTitle?: string;
  meetingDescription?: string;
  meetingDuration?: number;
}

const {
  uuid = BOOKING_CONFIG.uuid,
  submitUrl = BOOKING_CONFIG.submitUrl,
  slotsUrl = BOOKING_CONFIG.slotsUrl,
  apiBase = BOOKING_CONFIG.apiBase,
  meetingTitle = BOOKING_CONFIG.meetingTitle,
  meetingDescription = BOOKING_CONFIG.meetingDescription,
  meetingDuration = BOOKING_CONFIG.meetingDuration,
} = Astro.props;
---

<!-- Floating Consultation Bubble Launcher -->
<div class="booking-bubble-container" id="booking-bubble-launcher">
  <button
    type="button"
    class="booking-bubble-btn"
    data-booking-popup
    aria-label="Open Site Consultation Scheduler"
    title="Schedule a Landscape Consultation"
  >
    <div class="bubble-icon-wrap" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span class="bubble-pulse-dot"></span>
    </div>
    <div class="bubble-text">
      <span class="bubble-label-sub">Live Calendar</span>
      <span class="bubble-label-main">Book Consultation</span>
    </div>
  </button>
</div>

<!-- Modal Popup Overlay for Booking Widget -->
<div
  id="booking-popup-overlay"
  class="booking-popup-backdrop"
  hidden
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="booking-popup-title"
>
  <div class="booking-popup-card">
    <div class="booking-popup-header">
      <div class="popup-title-wrap">
        <span class="eyebrow" style="margin-bottom: 0.2rem;">Site Walkthrough Scheduling</span>
        <h3 id="booking-popup-title" class="popup-title">Book a 30-Min Landscape Consultation</h3>
      </div>
      <button
        type="button"
        class="booking-popup-close-btn"
        data-booking-popup-close
        aria-label="Close booking modal"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="booking-popup-body">
      <!-- Consultation Scope Strip -->
      <div class="consultation-scope-bar">
        <div class="scope-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Topography &amp; Sun</span>
        </div>
        <div class="scope-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Soil &amp; Trees</span>
        </div>
        <div class="scope-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Budget Scope</span>
        </div>
      </div>

      <!-- Custom local widget stylesheet -->
      <link rel="stylesheet" href="/booking-widget.css" />

      <!-- MFC Booking Widget Mount Container -->
      <div
        id="mfc-booking-widget"
        data-booking-widget=""
        data-form-uuid={uuid}
        data-api-base={apiBase}
        data-submit-url={submitUrl}
        data-slots-url={slotsUrl}
        data-meeting-title={meetingTitle}
        data-meeting-description={meetingDescription}
        data-meeting-duration={meetingDuration}
        data-branding-name={BOOKING_CONFIG.brandingName}
        data-branding-url={BOOKING_CONFIG.brandingUrl}
      >
        <div class="mfc-widget-placeholder">
          <div class="mfc-placeholder-spinner" aria-hidden="true"></div>
          <p class="mfc-placeholder-text">Connecting to consultation calendar…</p>
        </div>
      </div>

      <!-- Styled Attribution -->
      <!-- <FormAttribution /> -->
    </div>
  </div>
</div>

<!-- Booking widget runtime script -->
<script src="/booking-widget.js" defer></script>

<style>
  /* ==========================================================================
     Floating Bubble Launcher Styling
     ========================================================================== */
  .booking-bubble-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 998;
  }

  .booking-bubble-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, var(--color-primary-green, #1B4D36) 0%, var(--color-dark-green, #0F291E) 100%);
    color: #FFFFFF;
    border: 1px solid rgba(197, 160, 89, 0.4);
    padding: 0.75rem 1.25rem 0.75rem 1rem;
    border-radius: var(--radius-pill, 9999px);
    box-shadow: 0 10px 25px -4px rgba(15, 41, 30, 0.35), 0 4px 10px -2px rgba(197, 160, 89, 0.2);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: var(--font-sans, sans-serif);
  }

  .booking-bubble-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 16px 32px -4px rgba(15, 41, 30, 0.45), 0 6px 14px -2px rgba(197, 160, 89, 0.3);
    border-color: var(--color-gold, #C5A059);
  }

  .bubble-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-gold, #C5A059);
  }

  .bubble-pulse-dot {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #10B981;
    border: 2px solid var(--color-dark-green, #0F291E);
    animation: bubblePulse 2s infinite;
  }

  @keyframes bubblePulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .bubble-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.2;
  }

  .bubble-label-sub {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold, #C5A059);
    font-weight: 700;
  }

  .bubble-label-main {
    font-size: 0.88rem;
    font-weight: 700;
    color: #FFFFFF;
    white-space: nowrap;
  }

  /* ==========================================================================
     Modal Popup Overlay Styling
     ========================================================================== */
  .booking-popup-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background-color: rgba(11, 32, 23, 0.75);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow-y: auto;
  }

  .booking-popup-backdrop[hidden] {
    display: none !important;
  }

  .booking-popup-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border, rgba(15, 41, 30, 0.12));
    border-radius: var(--radius-md, 14px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
    width: 100%;
    max-width: 580px;
    margin: auto;
    overflow: hidden;
    animation: popupFadeIn 0.22s ease-out;
  }

  @keyframes popupFadeIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .booking-popup-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-primary, #FAF8F5);
    border-bottom: 1px solid var(--color-border-subtle, rgba(15, 41, 30, 0.07));
  }

  .popup-title {
    font-size: 1.2rem;
    color: var(--color-dark-green, #0F291E);
    margin: 0;
    line-height: 1.25;
  }

  .booking-popup-close-btn {
    border: none;
    background: rgba(15, 41, 30, 0.06);
    color: var(--color-dark-green, #0F291E);
    border-radius: 50%;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .booking-popup-close-btn:hover {
    background: rgba(15, 41, 30, 0.14);
    transform: scale(1.05);
  }

  .booking-popup-body {
    padding: 1.25rem 1.5rem 1.5rem;
    max-height: 80vh;
    overflow-y: auto;
  }

  /* Scope Strip inside modal */
  .consultation-scope-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
    padding: 0.65rem 0.85rem;
    background: #F8F9F5;
    border: 1px solid var(--color-border-subtle, rgba(15, 41, 30, 0.07));
    border-radius: var(--radius-sm, 8px);
    margin-bottom: 1rem;
  }

  .scope-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-dark-green, #0F291E);
  }

  .scope-item svg {
    color: var(--color-primary-green, #1B4D36);
  }

  @media (max-width: 640px) {
    .booking-bubble-container {
      bottom: 1.25rem;
      right: 1.25rem;
    }
    .bubble-text {
      display: none;
    }
    .booking-bubble-btn {
      padding: 0.65rem;
      border-radius: 50%;
    }
    .booking-popup-card {
      max-height: 90vh;
    }
  }
</style>
