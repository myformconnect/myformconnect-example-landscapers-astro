---
interface Props {
  title: string;
  category: string;
  description: string;
  imageSrc: string;
  imageAlt?: string;
  scope?: string[];
  num?: string;
  class?: string;
}

const {
  title,
  category,
  description,
  imageSrc,
  imageAlt = title,
  scope = [],
  num = "01",
  class: className = '',
} = Astro.props;
---

<article class={`editorial-project-card ${className}`} data-category={category}>
  <div class="project-media-stage">
    <img
      src={imageSrc}
      alt={imageAlt}
      class="project-img"
      loading="lazy"
      width="720"
      height="540"
    />
    <div class="project-top-meta">
      <span class="project-num-tag">{num}</span>
      <span class="project-cat-pill">{category}</span>
    </div>
  </div>

  <div class="project-info-stage">
    <div class="project-header-line">
      <h3 class="project-title">{title}</h3>
    </div>

    <p class="project-desc">{description}</p>

    {scope && scope.length > 0 && (
      <div class="project-spec-tags">
        {scope.map((tag) => (
          <span class="spec-tag">{tag}</span>
        ))}
      </div>
    )}

    <div class="project-action-row">
      <a href="/estimate" class="project-inquiry-link">
        <span>Inquire About Similar Commission</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .editorial-project-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth), border-color var(--transition-smooth);
    box-shadow: var(--shadow-subtle);
  }

  .editorial-project-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(27, 77, 54, 0.4);
  }

  .project-media-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3.1;
    overflow: hidden;
    background-color: var(--color-deep-forest);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-project-card:hover .project-img {
    transform: scale(1.05);
  }

  .project-top-meta {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .project-num-tag {
    background: rgba(11, 32, 23, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-gold);
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-style: italic;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-gold-border);
  }

  .project-cat-pill {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-dark-green);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(197, 160, 89, 0.35);
  }

  .project-info-stage {
    padding: clamp(1.4rem, 3vw, 1.95rem);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.85rem;
  }

  .project-title {
    font-size: 1.38rem;
    color: var(--color-dark-green);
    line-height: 1.22;
  }

  .project-desc {
    font-size: 0.9rem;
    line-height: 1.68;
    color: var(--color-text-secondary);
  }

  .project-spec-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.25rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .spec-tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-primary-green);
    background-color: var(--color-sage-tint);
    border: 1px solid rgba(27, 77, 54, 0.18);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-xs);
  }

  .project-action-row {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .project-inquiry-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary-green);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .project-inquiry-link:hover {
    color: var(--color-primary-hover);
    transform: translateX(3px);
  }
</style>
