---
import { COMPANY_INFO } from '../config/forms';

const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Practice Disciplines' },
  { href: '/projects', label: 'Selected Projects' },
  { href: '/contact', label: 'Contact Studio' },
  { href: '/contact#quote', label: 'Request Free Estimate' },
  { href: '/contact#booking', label: 'Book Site Walkthrough' },
];

const serviceLinks = [
  { href: '/services#landscape-design', label: 'Landscape Architecture & Master Planning' },
  { href: '/services#garden-renovation', label: 'Garden Design & Renewal' },
  { href: '/services#lawn-installation', label: 'Turf Engineering & Grading' },
  { href: '/services#outdoor-living', label: 'Bluestone Patios & Fire Features' },
  { href: '/services#tree-planting', label: 'Specimen Trees & Living Screens' },
  { href: '/services#commercial-landscaping', label: 'Commercial Grounds' },
  { href: '/services#irrigation-drainage', label: 'Water Management & Drainage' },
];
---

<footer class="site-footer">
  <!-- Main Footer Container -->
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Fictional Notice -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <div class="brand-logo" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="24" height="24" fill="none">
              <path d="M16 4C16 4 7 12 7 19C7 23.97 11.03 28 16 28C20.97 28 25 23.97 25 19C25 12 16 4 16 4Z" fill="#DCE5D8"/>
              <path d="M16 8V24M16 14L20 17.5M16 18.5L12 21" stroke="#1B3026" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="brand-name">{COMPANY_INFO.name}</span>
        </div>
        <p class="brand-tagline">{COMPANY_INFO.tagline}</p>
        <p class="brand-desc">
          Bespoke landscape architecture, estate garden renewals, precision turf installations, and outdoor gathering spaces throughout the Pacific Northwest.
        </p>
      </div>

      <!-- Col 2: Practice Disciplines -->
      <div class="footer-col">
        <h4 class="footer-heading">Disciplines</h4>
        <ul class="footer-links">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Studio Navigation -->
      <div class="footer-col">
        <h4 class="footer-heading">Studio Navigation</h4>
        <ul class="footer-links">
          {navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Studio Contact & Hours -->
      <div class="footer-col">
        <h4 class="footer-heading">Studio &amp; Hours</h4>
        <div class="footer-contact-info">
          <div class="info-row">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <a href={`tel:${COMPANY_INFO.phone}`}>{COMPANY_INFO.phone}</a>
          </div>
          <div class="info-row">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <a href={`mailto:${COMPANY_INFO.email}`}>{COMPANY_INFO.email}</a>
          </div>
          <div class="info-row">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{COMPANY_INFO.address}</span>
          </div>
          <div class="info-hours">
            <strong>Operating Hours:</strong>
            <p>{COMPANY_INFO.hours}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} {COMPANY_INFO.name}. All rights reserved. Fictional demonstration website.
      </p>
      <div class="footer-attribution">
        <span>Form &amp; Scheduling Engine:</span>
        <a href={COMPANY_INFO.attribution.url} target="_blank" rel="noopener noreferrer">
          MyFormConnect
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark-green);
    color: var(--color-text-inverse-muted);
    padding-top: clamp(4.5rem, 8vw, 6.5rem);
    padding-bottom: 2.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1.15fr 0.9fr 1.1fr;
    }
  }

  /* Brand Column */
  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-xs);
    background-color: rgba(220, 229, 216, 0.18);
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .brand-tagline {
    font-size: 0.85rem;
    color: var(--color-sage);
    font-weight: 500;
  }

  .brand-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.75);
  }
  
  /* Links & Headings */
  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.825rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.75);
    transition: color var(--transition-fast), padding-left var(--transition-fast);
    display: inline-block;
  }

  .footer-links a:hover {
    color: #FFFFFF;
    padding-left: 4px;
  }

  /* Contact Info */
  .footer-contact-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .info-row svg {
    color: var(--color-sage);
    flex-shrink: 0;
  }

  .info-row a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .info-hours {
    margin-top: 0.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.825rem;
  }

  .info-hours strong {
    color: #FFFFFF;
    display: block;
    margin-bottom: 0.25rem;
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-attribution a {
    color: #93C5FD;
    font-weight: 500;
  }

  .footer-attribution a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }
</style>
