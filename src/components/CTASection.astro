---
interface Props {
  title?: string;
  subtitle?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  variant?: 'green' | 'light';
}

const {
  title = "Ready to transform your outdoor space?",
  subtitle = "Tell us about your garden, landscape, or outdoor living project. We'll help you plan the next steps with a tailored estimate.",
  primaryCtaText = "Get Your Free Estimate",
  primaryCtaHref = "/estimate",
  secondaryCtaText = "Talk to Our Team",
  secondaryCtaHref = "/contact",
  variant = 'green',
} = Astro.props;
---

<section class={`cta-section ${variant === 'green' ? 'cta-green' : 'cta-light'}`}>
  <div class="container cta-container">
    <div class="cta-inner">
      <div class="cta-header">
        <span class={`eyebrow ${variant === 'green' ? 'eyebrow-light text-gold' : ''}`}>
          Commence Your Commission
        </span>
        <h2 class="cta-title">{title}</h2>
        <p class="cta-subtitle">{subtitle}</p>
      </div>

      <div class="cta-actions">
        <a href={primaryCtaHref} class={`btn btn-lg ${variant === 'green' ? 'btn-gold' : 'btn-primary'}`}>
          <span>{primaryCtaText}</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        {secondaryCtaText && secondaryCtaHref && (
          <a href={secondaryCtaHref} class={`btn btn-lg ${variant === 'green' ? 'btn-outline-white' : 'btn-secondary'}`}>
            <span>{secondaryCtaText}</span>
          </a>
        )}
      </div>

      <div class="cta-meta">
        <div class="meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Transparent line-item project estimates</span>
        </div>
        <div class="meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Direct consultation booking calendar</span>
        </div>
        <div class="meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Licensed &amp; Insured Landscape Contractors</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-top: clamp(4.5rem, 8vw, 7rem);
    padding-bottom: clamp(4.5rem, 8vw, 7rem);
    position: relative;
    overflow: hidden;
  }

  .cta-green {
    background: linear-gradient(165deg, var(--color-deep-forest) 0%, var(--color-dark-green) 50%, #143527 100%);
    color: #FFFFFF;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cta-green .cta-title {
    color: #FFFFFF;
  }

  .cta-green .cta-subtitle {
    color: rgba(255, 255, 255, 0.85);
  }

  .cta-light {
    background-color: var(--bg-secondary);
    color: var(--color-dark-green);
    border-top: 1px solid var(--color-border);
  }

  .cta-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .cta-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta-title {
    font-size: clamp(2.1rem, 4vw, 3.25rem);
    line-height: 1.16;
  }

  .cta-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    line-height: 1.68;
    max-width: 640px;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .cta-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 0.825rem;
  }

  .cta-light .cta-meta {
    border-top-color: var(--color-border);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 500;
  }

  .cta-green .meta-item svg {
    color: var(--color-sage);
  }

  .cta-light .meta-item svg {
    color: var(--color-primary-green);
  }
</style>
