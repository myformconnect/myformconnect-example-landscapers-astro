---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';

const serviceCategories = [
  {
    id: "landscape-design",
    num: "01",
    eyebrow: "Discipline 01 &middot; Master Architecture",
    title: "Landscape Design & Master Planning",
    subtitle: "Harmonizing residence architecture with topography, daylight, and botanical ecology.",
    imageSrc: "/images/landscape_design_and_planning.webp",
    description: "Our comprehensive planning process analyzes site contours, solar exposure, stormwater runoff, and long-term tree canopies. We translate client lifestyle into layered 3D spatial models and precise material specifications before any earth is moved.",
    materials: ["Topographical grading studies", "Native fescues & architectural boxwoods", "Bluestone & reclaimed cedar elements"],
    features: [
      "Topographical survey & 3D digital landscape modeling",
      "Native & climate-resilient botanical selections",
      "Outdoor pedestrian circulation & zoning plans",
      "Comprehensive hardscape & masonry blueprints",
      "Low-voltage ambient illumination layouts"
    ],
  },
  {
    id: "garden-renovation",
    num: "02",
    eyebrow: "Discipline 02 &middot; Horticultural Renewal",
    title: "Garden Design & Renovation",
    subtitle: "Restoring organic vitality to neglected, overcrowded, or aging Pacific Northwest grounds.",
    imageSrc: "/images/garden_design_and_renovation.jpeg",
    description: "Whether revitalizing established perennial beds or executing a complete property renovation, our certified horticulturists remediate exhausted soil biomes, reconstruct dry-stacked stone retaining walls, and introduce layered four-season botanical textures.",
    materials: ["Compost-amended sandy loam", "Fieldstone retaining walls", "Multi-tier perennial & shrub drifts"],
    features: [
      "Soil biome testing & organic compost enrichment",
      "Selective pruning, crown thinning & tree preservation",
      "Tiered perennial borders with multi-season bloom schedules",
      "Decorative fieldstone borders & weed suppression layers",
      "Micro-climate shade and moisture zoning"
    ],
  },
  {
    id: "lawn-installation",
    num: "03",
    eyebrow: "Discipline 03 &middot; Turf Engineering",
    title: "Lawn Installation & Turf Care",
    subtitle: "Enduring, weed-resistant emerald turf engineered from foundational grading upward.",
    imageSrc: "/images/lawn_installation_and_turf.jpeg",
    description: "A resilient lawn requires proper ground preparation. We laser-grade soil sub-bases to eliminate pooling, blend specialized organic amendments, and install certified regional sod varieties that resist foot traffic, pests, and summer droughts.",
    materials: ["Laser-graded sub-base", "Certified Pacific Northwest fescue blend", "Automated subterranean moisture sensors"],
    features: [
      "Precision laser grading & slope runoff control",
      "Exhausted turf removal & deep subterranean aeration",
      "Certified regional drought-tolerant fescue & bluegrass sod",
      "Integrated sub-surface drip & low-angle spray design",
      "Seasonal biological fertilizing & thatch management"
    ],
  },
  {
    id: "outdoor-living",
    num: "04",
    eyebrow: "Discipline 04 &middot; Artisan Hardscapes",
    title: "Outdoor Living Spaces & Patios",
    subtitle: "Extending interior refinement into sheltered, open-air living and dining terraces.",
    imageSrc: "/images/outdoor_living_patio_design.jpg",
    description: "From hand-tooled natural bluestone terraces and contemporary thermal pavers to custom natural stone fire features and timber pergola structures, we construct outdoor gathering rooms built to endure Northwest rainfall and frosty winters.",
    materials: ["Quarried thermal bluestone", "Western red cedar timbers", "Natural gas artisan fire features"],
    features: [
      "Thermal-finished bluestone, granite & permeable paver terraces",
      "Custom gas fire tables, fire pits & outdoor stone fireplaces",
      "Architectural cedar pergolas, privacy louvers & trellis screens",
      "Integrated outdoor kitchen stations & stone bar counters",
      "Concealed downspout drainage & frost-heave defense"
    ],
  },
  {
    id: "tree-planting",
    num: "05",
    eyebrow: "Discipline 05 &middot; Living Architecture",
    title: "Tree & Specimen Plant Installation",
    subtitle: "Structural canopy shade, blooming ornamental groves, and dense privacy hedges.",
    imageSrc: "/images/planting_tree_installation.jpeg",
    description: "Trees and structural shrubs define the living framework of any landscape. We hand-select specimen trees directly from reputable regional growers, transporting and crane-planting them with comprehensive root-flare preservation and biological soil inoculation.",
    materials: ["Acclimatized regional nursery stock", "Mycorrhizal root inoculants", "Protective cedar bark mulch"],
    features: [
      "Mature shade & ornamental specimen tree crane installation",
      "Dense evergreen privacy screens (Arborvitae, Laurel, Yew)",
      "Pollinator-supporting native understory shrub colonies",
      "Deep-root biological feeding & structural guy-wire staking",
      "Multi-year root establishment warranty & monitoring"
    ],
  },
  {
    id: "commercial-landscaping",
    num: "06",
    eyebrow: "Discipline 06 &middot; Commercial Presence",
    title: "Commercial Landscaping & Corporate Grounds",
    subtitle: "Striking corporate campuses, retail entries, and sustainable property developments.",
    imageSrc: "/images/Commercial_Landscaping.jpeg",
    description: "Create an unmistakable first impression for clients, tenants, and visitors. Evergreen Landscapes delivers high-impact street frontage, modern drought-tolerant gravel plazas, and low-maintenance green spaces with zero interruption to daily operations.",
    materials: ["Decomposed granite & crushed basalt", "Corten architectural planters", "Hardy architectural ornamental grasses"],
    features: [
      "Corporate campus master planning & construction",
      "Executive entrance courtyards & seasonal rotation planters",
      "Water-conserving xeriscape & permeable gravel circulation",
      "Commercial maintenance specifications & irrigation auditing",
      "ADA-compliant walkway grades & safety lighting"
    ],
  },
  {
    id: "irrigation-drainage",
    num: "07",
    eyebrow: "Discipline 07 &middot; Water Conservation",
    title: "Irrigation & Subsurface Drainage Solutions",
    subtitle: "Safeguarding landscape longevity with smart hydrological management.",
    imageSrc: "/images/irrigation_dranage_solution.jpeg",
    description: "Excess water compromises foundations and plantings, while underwatering wastes valuable resources. We engineer weather-sensing smart drip arrays alongside hidden gravel French drains, catch basins, and bioswales that manage high Northwest precipitation naturally.",
    materials: ["Smart weather-based Wi-Fi controllers", "Perforated subterranean French drains", "Low-volume pressure-compensating emitters"],
    features: [
      "Wi-Fi connected weather-sensing irrigation controllers",
      "Targeted root-zone drip lines & pressure-regulated micro-emitters",
      "Subsurface French drain systems & foundation waterproofing",
      "Rain gardens, permeable swales & stormwater recharge",
      "Spring backflow testing, activation & winterization blowouts"
    ],
  },
];
---

<MainLayout
  title="Landscaping Disciplines & Services | Evergreen Landscapes"
  description="Explore our specialized landscaping practices: architectural landscape design, bluestone patios, turf installation, mature tree planting, commercial grounds, and drainage."
  activePath="/services"
>
  <!-- Services Header Hero -->
  <section class="services-hero-section section-padding-sm" style="background: linear-gradient(165deg, var(--color-deep-forest) 0%, var(--color-dark-green) 50%, #143527 100%); color: #FFFFFF;">
    <div class="container text-center">
      <div class="services-hero-inner">
        <span class="eyebrow eyebrow-light text-gold">Practice Disciplines</span>
        <h1 class="services-hero-title">Architectural Landscaping Services</h1>
        <p class="services-hero-subtitle">
          Every commission is executed by certified horticulturists, master stonemasons, and licensed site superintendents committed to enduring landscape craftsmanship.
        </p>
        <div class="hero-cta-group">
          <a href="/contact#quote" class="btn btn-gold btn-lg">
            <span>Request an Estimate</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/contact#booking" class="btn btn-outline-white btn-lg">
            <span>Book Site Consultation</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Discipline Anchor Bar -->
  <nav class="disciplines-nav-strip" aria-label="Jump to service discipline">
    <div class="container strip-scroll-container">
      {serviceCategories.map((cat) => (
        <a href={`#${cat.id}`} class="strip-link">
          <span class="strip-num">{cat.num}</span>
          <span class="strip-name">{cat.title.split('&')[0].trim()}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- Detailed Service Disciplines -->
  <section class="services-list-section section-padding">
    <div class="container">
      <div class="services-stream">
        {serviceCategories.map((item, index) => (
          <article
            class={`discipline-block ${index % 2 === 1 ? 'reverse-layout' : ''}`}
            id={item.id}
          >
            <!-- Media Column -->
            <div class="discipline-media">
              <div class="media-frame">
                <img
                  src={item.imageSrc}
                  alt={item.title}
                  class="discipline-img"
                  loading="lazy"
                  width="720"
                  height="490"
                />
                <span class="media-stamp">{item.num} / 07</span>
              </div>

              <!-- Materials Spec Box -->
              <div class="discipline-materials-box">
                <span class="mat-label">Selected Materials &amp; Methods:</span>
                <ul class="mat-tags">
                  {item.materials.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Content Column -->
            <div class="discipline-content">
              <span class="eyebrow">{item.eyebrow}</span>
              <h2 class="discipline-title">{item.title}</h2>
              <p class="discipline-subtitle">{item.subtitle}</p>
              <p class="discipline-desc">{item.description}</p>

              <div class="discipline-features-card">
                <h4>Core Inclusions:</h4>
                <ul class="features-checklist">
                  {item.features.map((feat) => (
                    <li>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="discipline-actions">
                <a href="/contact#quote" class="btn btn-primary">
                  <span>Get Estimate for This Discipline</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <a href="/contact#booking" class="btn btn-secondary">
                  <span>Schedule Site Walk</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Conversion CTA Banner -->
  <CTASection
    title="Ready to discuss your landscape plans?"
    subtitle="Let's build a functional, enduring, and stunning outdoor environment. Submit your project requirements or book an on-site consultation."
    primaryCtaText="Get Your Free Estimate"
    primaryCtaHref="/contact#quote"
    secondaryCtaText="Book a Site Consultation"
    secondaryCtaHref="/contact#booking"
  />
</MainLayout>

<style>
  .services-hero-section {
    text-align: center;
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
  }

  .services-hero-inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .services-hero-title {
    color: #FFFFFF;
    text-align: center;
    margin-bottom: 1.25rem;
    width: 100%;
  }

  .services-hero-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 720px;
    margin: 0 auto 2.5rem;
    line-height: 1.65;
    text-align: center;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
  }

  /* Anchor Nav Strip */
  .disciplines-nav-strip {
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 4.85rem;
    z-index: 100;
  }

  .strip-scroll-container {
    display: flex;
    gap: 1.75rem;
    overflow-x: auto;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
    scrollbar-width: none;
  }

  .strip-scroll-container::-webkit-scrollbar {
    display: none;
  }

  .strip-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .strip-link:hover {
    color: var(--color-dark-green);
  }

  .strip-num {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-primary-green);
  }

  /* Disciplines Stream */
  .services-stream {
    display: flex;
    flex-direction: column;
    gap: clamp(4.5rem, 8vw, 7.5rem);
  }

  .discipline-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
    scroll-margin-top: 9rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .discipline-block:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  @media (min-width: 960px) {
    .discipline-block {
      grid-template-columns: 1fr 1fr;
    }

    .discipline-block.reverse-layout .discipline-media {
      order: 2;
    }

    .discipline-block.reverse-layout .discipline-content {
      order: 1;
    }
  }

  .discipline-media {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .media-frame {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    aspect-ratio: 16 / 11;
    background-color: var(--bg-secondary);
    border: 1px solid var(--color-border);
  }

  .discipline-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .discipline-block:hover .discipline-img {
    transform: scale(1.03);
  }

  .media-stamp {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(27, 48, 38, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--color-sage);
    font-family: var(--font-serif);
    font-size: 0.8rem;
    font-style: italic;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .discipline-materials-box {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mat-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .mat-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .mat-tags li {
    font-size: 0.78rem;
    color: var(--color-dark-green);
    background-color: var(--bg-secondary);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-xs);
    font-weight: 500;
  }

  .discipline-content {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .discipline-title {
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
    line-height: 1.2;
  }

  .discipline-subtitle {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-primary-green);
    line-height: 1.55;
  }

  .discipline-desc {
    font-size: 0.925rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .discipline-features-card {
    margin-top: 0.35rem;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1.5rem;
  }

  .discipline-features-card h4 {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-dark-green);
    margin-bottom: 0.85rem;
  }

  .features-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .features-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.85rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .features-checklist svg {
    color: var(--color-primary-green);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .discipline-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
</style>
