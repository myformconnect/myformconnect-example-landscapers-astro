---
import MainLayout from '../layouts/MainLayout.astro';
import BookingBubbleModal from '../components/BookingBubbleModal.astro';
import ContactForm from '../components/ContactForm.astro';
import CTASection from '../components/CTASection.astro';
import { COMPANY_INFO } from '../config/forms';
---

<MainLayout
  title="Contact & Site Consultations | Evergreen Landscapes"
  description="Connect with our landscape studio, send a direct message, or schedule an on-site landscape consultation. Serving Portland Metro and surrounding communities."
  activePath="/contact"
>
  <!-- Section 1: Page Hero -->
  <section class="contact-hero-section section-padding-sm" style="background: linear-gradient(165deg, var(--color-deep-forest) 0%, var(--color-dark-green) 50%, #143527 100%); color: #FFFFFF;">
    <div class="container text-center">
      <div class="contact-hero-inner">
        <span class="eyebrow eyebrow-light text-gold">Client Engagement &amp; Studio Desk</span>
        <h1 class="contact-hero-title">Connect with our Landscape Studio</h1>
        <p class="contact-hero-subtitle">
          Have a question or looking to discuss your grounds? Connect directly with our team, send a quick note below, or schedule an on-site consultation.
        </p>
        <div class="contact-hero-actions">
          <a href="#quick-contact" class="btn btn-gold btn-lg">
            <span>Send a Quick Note</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </a>
          <button type="button" class="btn btn-outline-white btn-lg" data-booking-popup>
            <span>Book Site Consultation</span>
          </button>
          <a href="/estimate" class="btn btn-outline-white btn-lg">
            <span>Request a Free Estimate</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Studio Coordinates & Send a Quick Note Form -->
  <section class="direct-contact-section section-padding" id="quick-contact">
    <div class="container">
      <div class="section-header text-center" style="max-width: 680px; margin: 0 auto 3rem;">
        <span class="eyebrow">Direct Studio Engagement</span>
        <h2>Studio Coordinates &amp; Direct Message</h2>
        <p class="section-subtitle">
          Whether you need immediate contact details or want to send our project estimators a note, reach our studio directly.
        </p>
      </div>

      <div class="contact-two-col-grid">
        <!-- Left Column: Studio Coordinates -->
        <div class="studio-details-col">
          <div class="studio-info-card">
            <span class="eyebrow">Studio Coordinates</span>
            <h3 class="info-card-title">Evergreen Landscapes</h3>
            <p class="info-card-desc">
              Connect directly with our master horticulturalists, project estimators, and site superintendents.
            </p>

            <div class="info-items-list">
              <!-- Phone -->
              <div class="info-item-row">
                <div class="info-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </div>
                <div class="info-text">
                  <span class="label">Direct Line</span>
                  <a href={`tel:${COMPANY_INFO.phone}`} class="value">{COMPANY_INFO.phone}</a>
                </div>
              </div>

              <!-- Email -->
              <div class="info-item-row">
                <div class="info-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                </div>
                <div class="info-text">
                  <span class="label">Estimates Desk</span>
                  <a href={`mailto:${COMPANY_INFO.email}`} class="value">{COMPANY_INFO.email}</a>
                </div>
              </div>

              <!-- Address -->
              <div class="info-item-row">
                <div class="info-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </div>
                <div class="info-text">
                  <span class="label">Studio &amp; Yard</span>
                  <span class="value">{COMPANY_INFO.address}</span>
                </div>
              </div>

              <!-- Hours -->
              <div class="info-item-row">
                <div class="info-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                </div>
                <div class="info-text">
                  <span class="label">Operating Hours</span>
                  <span class="value">{COMPANY_INFO.hours}</span>
                </div>
              </div>
            </div>

            <!-- Need Detailed Quote Promo Card -->
            <div class="estimate-promo-box">
              <span class="promo-tag">Looking for an Estimate?</span>
              <p class="promo-text">
                Need a comprehensive itemized quote with material specifications and timeline breakdown?
              </p>
              <a href="/estimate" class="promo-link">
                <span>Go to Free Estimate Page</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

            <!-- Fictional Demo Notice -->
            <div class="demo-disclosure-box">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              <span>Demonstration Website. All details are sample demonstration info for MyFormConnect.</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Send a Quick Note Form -->
        <div class="quick-note-col">
          <div class="direct-message-card">
            <div class="card-message-header">
              <span class="eyebrow">Quick Inquiry</span>
              <h3 class="message-card-title">Send a Quick Note</h3>
              <p class="message-card-desc">
                Fill out the fields below and our team will get back to you shortly.
              </p>
            </div>

            <ContactForm formId="direct-inquiry-form" isCard={false} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Booking Bubble & Modal Trigger -->
  <BookingBubbleModal />

  <!-- Bottom CTA -->
  <CTASection
    title="Ready for a full landscape proposal?"
    subtitle="Submit your project requirements, scope of work, and site measurements for an itemized breakdown."
    primaryCtaText="Request a Free Estimate"
    primaryCtaHref="/estimate"
    secondaryCtaText="Explore Our Projects"
    secondaryCtaHref="/projects"
    variant="light"
  />
</MainLayout>

<style>
  .contact-hero-section {
    text-align: center;
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
  }

  .contact-hero-inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact-hero-title {
    color: #FFFFFF;
    text-align: center;
    margin-bottom: 1.25rem;
    width: 100%;
  }

  .contact-hero-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 720px;
    margin: 0 auto 2.25rem;
    line-height: 1.65;
    text-align: center;
  }

  .contact-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
  }

  /* Section 2: Direct Contact (Studio Coordinates + Send a Quick Note) */
  .direct-contact-section {
    background-color: var(--bg-primary);
  }

  .contact-two-col-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 3.5vw, 3rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-two-col-grid {
      grid-template-columns: 1fr 1.25fr;
    }
  }

  .studio-details-col,
  .quick-note-col {
    width: 100%;
  }

  .studio-info-card,
  .direct-message-card {
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    box-shadow: var(--shadow-card);
  }

  .card-message-header {
    margin-bottom: 1.25rem;
  }

  .info-card-title,
  .message-card-title {
    font-size: 1.5rem;
    color: var(--color-dark-green);
    margin-bottom: 0.4rem;
  }

  .info-card-desc,
  .message-card-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .info-items-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .info-item-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .info-icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-xs);
    background-color: var(--color-sage-tint);
    color: var(--color-primary-green);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-text {
    display: flex;
    flex-direction: column;
  }

  .info-text .label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .info-text .value {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--color-dark-green);
    line-height: 1.4;
  }

  .info-text a.value:hover {
    color: var(--color-primary-green);
    text-decoration: underline;
  }

  .estimate-promo-box {
    margin-top: 1.75rem;
    padding: 1.25rem;
    background: var(--color-sage-tint);
    border-radius: var(--radius-xs);
    border: 1px solid rgba(27, 77, 54, 0.15);
  }

  .promo-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-green);
    margin-bottom: 0.35rem;
  }

  .promo-text {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .promo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary-green);
    transition: color var(--transition-fast);
  }

  .promo-link:hover {
    color: var(--color-dark-green);
    text-decoration: underline;
  }

  .demo-disclosure-box {
    margin-top: 1.5rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-xs);
    background: var(--bg-primary);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .demo-disclosure-box svg {
    color: var(--color-primary-green);
    flex-shrink: 0;
  }
</style>
