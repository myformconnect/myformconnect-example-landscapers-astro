---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTASection from '../components/CTASection.astro';

const projects = [
  {
    num: "01",
    title: "Oakridge Estate Sanctuary",
    category: "Residential Gardens",
    description: "A secluded private estate garden combining tiered bluestone terraces, formal hornbeam hedges, and an organic perennial border designed for continuous seasonal bloom.",
    imageSrc: "/images/Oakridge_Estate_Sanctuary.jpeg",
    scope: ["Lake Oswego, OR", "Quarried Bluestone", "Pleached Hornbeams", "Master Plan"],
  },
  {
    num: "02",
    title: "Highland Terrace & Fire Feature",
    category: "Modern Patios",
    description: "Minimalist outdoor living terrace featuring large-format slate pavers, custom cedar privacy pergolas, integrated LED stair lighting, and an artisan gas fire pit.",
    imageSrc: "/images/Highland_Terrace_and_Fire_Feature.jpeg",
    scope: ["West Hills, OR", "Thermal Slate Pavers", "Cedar Pergola", "Gas Fire Table"],
  },
  {
    num: "03",
    title: "Pinecrest Hillside Overhaul",
    category: "Lawn Transformations",
    description: "Transformation of an eroded hillside into a multi-tiered green haven with laser-graded premium turf sod, basalt retaining walls, and French drainage.",
    imageSrc: "/images/Pinecrest_Hillside_Overhaul.jpg",
    scope: ["Dunthorpe, OR", "Laser-Graded Turf", "Basalt Dry-Stack", "French Drains"],
  },
  {
    num: "04",
    title: "Northwest Tech Campus Courtyard",
    category: "Commercial Landscapes",
    description: "A corporate campus green space offering collaboration zones, drought-resilient prairie grasses, permeable gravel paths, and shaded pavilions.",
    imageSrc: "/images/Northwest_Tech_Campus_Courtyard.jpg",
    scope: ["Pearl District, OR", "Decomposed Granite", "Drought-Resilient Sedges", "Corten Steel"],
  },
  {
    num: "05",
    title: "Contemporary Outdoor Patio",
    category: "Modern Patios",
    description: "Architectural outdoor dining and entertaining terrace framed with precision thermal pavers, privacy louvers, and a centerpiece fire table.",
    imageSrc: "/images/contemporary_outdoor_patio.jpeg",
    scope: ["West Linn, OR", "Slate Pavers", "Cedar Louvers", "Artisan Fire Bowl"],
  },
  {
    num: "06",
    title: "Modern Residential Garden",
    category: "Residential Gardens",
    description: "Tranquil private garden integrating manicured topiary parterres, smooth bluestone perimeter walks, and four-season perennial drifts.",
    imageSrc: "/images/modern_residential_garden.jpeg",
    scope: ["Lake Oswego, OR", "Formal Hedges", "Bluestone Walk", "Perennial Drifts"],
  },
  {
    num: "07",
    title: "Lush Backyard Transformation",
    category: "Garden Renovations",
    description: "Complete hillside renewal with natural dry-stacked fieldstone terraces, native coneflowers, salvia drifts, and subterranean slope drainage.",
    imageSrc: "/images/lush_backyard_transformation.jpeg",
    scope: ["Mount Tabor, OR", "Dry-Stacked Stone", "Hillside Terraces", "Subsurface Drainage"],
  },
  {
    num: "08",
    title: "Commercial Green Space",
    category: "Commercial Landscapes",
    description: "Striking multi-tenant commercial courtyard featuring permeable basalt gravel paths, architectural planters, and drought-tolerant prairie grasses.",
    imageSrc: "/images/commercial_green_space.jpeg",
    scope: ["Pearl District, OR", "Gravel Plazas", "Prairie Grasses", "Architectural Planters"],
  },
  {
    num: "09",
    title: "Sunstone Native Landscape",
    category: "Outdoor Living",
    description: "Eco-conscious living space featuring native Oregon scrub, weathered decomposed granite walkways, custom timber benches, and automated smart drip lines.",
    imageSrc: "/images/Sunstone_Native_Landscape.avif",
    scope: ["Eastmoreland, OR", "Native Xeriscape", "Decomposed Granite", "Automated Drip Lines"],
  },
];

const categories = [
  "All Projects",
  "Residential Gardens",
  "Modern Patios",
  "Lawn Transformations",
  "Garden Renovations",
  "Commercial Landscapes",
  "Outdoor Living",
];
---

<MainLayout
  title="Our Projects & Portfolio | Evergreen Landscapes"
  description="Explore our portfolio of completed landscape designs, garden renovations, modern patios, and commercial green spaces."
  activePath="/projects"
>
  <!-- Page Hero -->
  <section class="projects-hero-section section-padding-sm" style="background: linear-gradient(165deg, var(--color-deep-forest) 0%, var(--color-dark-green) 50%, #143527 100%); color: #FFFFFF;">
    <div class="container text-center">
      <div class="projects-hero-inner">
        <span class="eyebrow eyebrow-light text-gold">Selected Commissions</span>
        <h1 class="projects-hero-title">Landscapes designed for living.</h1>
        <p class="projects-hero-subtitle">
          Explore a selection of outdoor spaces, garden designs, and landscape transformations crafted by Evergreen Landscapes across the Pacific Northwest.
        </p>
        <div class="projects-hero-cta">
          <a href="/contact#quote" class="btn btn-gold btn-lg">
            <span>Request an Estimate</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter Bar & Projects Grid -->
  <section class="portfolio-section section-padding">
    <div class="container">
      <!-- Filter Bar -->
      <div class="filter-controls">
        <div class="filter-wrapper" role="tablist" aria-label="Filter commissions by category">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-btn ${idx === 0 ? 'active' : ''}`}
              data-filter={cat === "All Projects" ? "all" : cat}
              role="tab"
              aria-selected={idx === 0 ? "true" : "false"}
            >
              {cat}
            </button>
          ))}
        </div>
        <div class="filter-counter">
          <span id="active-filter-label">Showing all {projects.length} curated commissions</span>
        </div>
      </div>

      <!-- Projects Grid -->
      <div class="projects-editorial-grid" id="projects-grid">
        {projects.map((proj) => (
          <div class="project-grid-item" data-category={proj.category}>
            <ProjectCard
              num={proj.num}
              title={proj.title}
              category={proj.category}
              description={proj.description}
              imageSrc={proj.imageSrc}
              scope={proj.scope}
            />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div class="projects-empty-state" id="projects-empty" style="display: none;">
        <p>No commissions currently listed under this category. Contact us to inquire about custom projects.</p>
      </div>
    </div>
  </section>

  <!-- End Conversion Banner -->
  <CTASection
    title="Have a project in mind?"
    subtitle="Whether you're starting from a blank canvas or revitalizing existing grounds, our team is ready to bring your vision to life."
    primaryCtaText="Request Your Free Estimate"
    primaryCtaHref="/contact#quote"
    secondaryCtaText="Book Site Consultation"
    secondaryCtaHref="/contact#booking"
  />
</MainLayout>

<style>
  .projects-hero-section {
    text-align: center;
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 7vw, 6rem);
  }

  .projects-hero-inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .projects-hero-title {
    color: #FFFFFF;
    text-align: center;
    margin-bottom: 1.25rem;
    width: 100%;
  }

  .projects-hero-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 680px;
    margin: 0 auto 2.25rem;
    line-height: 1.65;
    text-align: center;
  }

  .projects-hero-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  /* Filter Controls */
  .filter-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .filter-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .filter-btn {
    border: 1px solid var(--color-border);
    background: #FFFFFF;
    color: var(--color-text-secondary);
    font-size: 0.825rem;
    font-weight: 600;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--color-primary-green);
    color: var(--color-dark-green);
    background-color: var(--bg-secondary);
  }

  .filter-btn.active {
    background-color: var(--color-dark-green);
    color: #FFFFFF;
    border-color: var(--color-dark-green);
    box-shadow: 0 2px 8px rgba(27, 48, 38, 0.2);
  }

  .filter-counter {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Projects Grid */
  .projects-editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
  }

  @media (min-width: 640px) {
    .projects-editorial-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-editorial-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-grid-item {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .project-grid-item.hidden {
    display: none;
  }

  .projects-empty-state {
    text-align: center;
    padding: 4.5rem 2rem;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }
</style>

<script is:inline>
  (function () {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectItems = document.querySelectorAll('.project-grid-item');
    const emptyState = document.getElementById('projects-empty');
    const counterLabel = document.getElementById('active-filter-label');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const filterVal = btn.getAttribute('data-filter');
        let visibleCount = 0;

        projectItems.forEach((item) => {
          const category = item.getAttribute('data-category');
          if (filterVal === 'all' || category === filterVal) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (counterLabel) {
          counterLabel.textContent = filterVal === 'all'
            ? `Showing all ${projectItems.length} curated commissions`
            : `Showing ${visibleCount} ${visibleCount === 1 ? 'commission' : 'commissions'} in ${filterVal}`;
        }

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  })();
</script>
